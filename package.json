{
  "name": "agribridge-root",
  "private": true,
  "version": "1.0.0",
  "description": "Root orchestrator for AgriBridge: Pakistan-Saudi Arabia Sustainable Food Pipeline",
  "scripts": {
    "dev:web": "npm run dev --prefix apps/web",
    "dev:worker": "npm run dev --prefix workers",
